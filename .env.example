# OutreachIQ - copy this file to .env and fill in real values.
# .env is gitignored. Never paste credentials in chat.
GMAIL_ADDRESS=your_address@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
SENDER_DISPLAY_NAME=Your Name
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
MAX_RECIPIENTS_PER_CAMPAIGN=100
SEND_DELAY_SECONDS=5
